## alias
alias ls="ls --color=auto"
alias la="ls -A --color=auto"
alias ll="ls -h -la --color=auto"
alias nf="neofetch | lolcat"
alias r="ranger"
alias vi="nvim"

##awsome fzf alias
alias f='fzf --height 40% --reverse --bind "enter:become(nvim {})"'
alias fh='find ~ -type f | fzf --height 40% --reverse --bind "enter:become(nvim {})"'
alias fr='find ~/.config -type f | fzf --height 40% --reverse --bind "enter:become(nvim {})"'

alias dotfiles='/usr/bin/git --git-dir="$HOME/.dotfiles/" --work-tree="$HOME"'
alias sdot='dotfiles ls-tree -r kodearch --name-only'
