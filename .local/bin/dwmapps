#!/bin/sh

TERMENU="$XDG_DATA_HOME/rofi/termenu"
ALACRITTY_X11="alacritty msg create-window --class scratchapp -o font.size=6.5"
ALACRITTY_WLR="alacritty msg create-window --class floatterm"
prompt="🔎 "

if [[ $XDG_SESSION_TYPE = wayland ]]; then
  ALACRITTY=$ALACRITTY_WLR
else
  ALACRITTY=$ALACRITTY_X11
fi

cmd=$(cat $TERMENU | awk '{print $1 " " $2}' | dmenu -i -p $prompt "$@")
if [[ -n $cmd ]]; then
  ops=$(grep "$cmd" "$TERMENU" | sed -E 's/^(.\s\w+\s)//g')
  $ALACRITTY -T "$ops" -e $ops >/dev/null
fi
