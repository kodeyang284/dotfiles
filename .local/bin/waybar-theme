#!/bin/sh
set -e

WAYBARHOME="$XDG_CONFIG_HOME/waybar"
CONFIGFILE="config.jsonc"
STYLEFILE="style.css"
WAYBAR_RESTART="$WAYBARHOME/relaunch.sh"

if [[ $1 ]]; then
  themedir="$WAYBARHOME/themes/$1"
  if [[ ! $themedir ]];then
    echo "can not find the theme"
    exit 1
  else
    ln -sf $themedir/$STYLEFILE "$WAYBARHOME/$STYLEFILE"
    ln -sf $themedir/$CONFIGFILE "$WAYBARHOME/$CONFIGFILE"
    echo "change waybar theme to $1"
    $WAYBAR_RESTART
  fi
else
  $WAYBAR_RESTART
  echo "specify themes"
  exit 1
fi
