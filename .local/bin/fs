#!/bin/sh

_find() {
  path="$(which "$1" 2>/dev/null)"
  if [[ ! $path ]]
  then
    exit 1
  else
    realpath "$path"
    exit 0
  fi
}

is_script() {
  file "$1" | grep -q "script"
}

main() {
  if [ -n "$1" ]
  then 
    src="$(_find "$1")"
    if is_script "$src"
    then
      $EDITOR "$src"
    else
      echo "not a script"
    fi
  fi
}

main "$@"
